# Telegram Bot Token from @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstUVwxyz

# Your Telegram Channel ID (e.g. -1001234567890 or @your_channel_username)
TARGET_CHANNEL_ID=@your_channel_username

# Your personal TeraBox ndus cookie (from browser DevTools -> Application -> Cookies -> terabox.com -> ndus)
NDUS_COOKIE=your_terabox_ndus_cookie_here

# Your deployed Cloudflare Worker URL (e.g., https://teravidsplay-proxy.yourname.workers.dev)
WORKER_URL=https://teravidsplay-proxy.yourname.workers.dev

# Your deployed Web Player URL (e.g., https://teravidsplay.vercel.app)
PLAYER_URL=https://teravidsplay.vercel.app
