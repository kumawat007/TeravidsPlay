# Telegram Bot Token from @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstUVwxyz

# Your Telegram Channel ID (e.g. -1001234567890 or @your_channel_username)
TARGET_CHANNEL_ID=@your_channel_username

# Your personal TeraBox ndus cookie (from browser DevTools -> Application -> Cookies -> terabox.com -> ndus)
NDUS_COOKIE=your_terabox_ndus_cookie_here

# Your deployed Cloudflare Worker URL (e.g., https://teravidsplay-proxy.yourname.workers.dev)
WORKER_URL=https://teravidsplay-proxy.yourname.workers.dev

# Your deployed Web Player URL (e.g., https://teravidsplay.vercel.app)
PLAYER_URL=https://teravidsplay.vercel.app

# Optional Security Tokens:
# Secret token to protect admin diagnostic endpoints (/diag) against public probing
ADMIN_SECRET=your_super_secret_admin_token_here

# Secret token for Telegram Webhook authentication (X-Telegram-Bot-Api-Secret-Token)
WEBHOOK_SECRET=your_telegram_webhook_secret_here

# Optional comma-separated Telegram User IDs allowed to auto-publish DM links to TARGET_CHANNEL_ID
# (Channel Creators and Administrators are always authorized automatically)
ADMIN_USER_IDS=

# Max individual Telegram cards sent when a folder link contains multiple videos (default: 25)
MAX_FOLDER_CARDS=25

# Optional third-party DiskWala API endpoint & key (if you subscribe to a licensed DiskWala resolver API)
DISKWALA_API_URL=
DISKWALA_API_KEY=
