{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/v/:id",
      "destination": "/player/index.html?v=:id"
    },
    {
      "source": "/s/:id",
      "destination": "/player/index.html?s=:id"
    },
    {
      "source": "/",
      "destination": "/player/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/player/$1"
    }
  ]
}
