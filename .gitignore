# ==============================================================================
# 🎬 TeravidsPlay — Top-Tier Security & Production .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CRITICAL SECURITY: Environment Variables & Secrets (NEVER COMMIT!)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
bot/.env
worker/.env
player/.env
*.pem
*.key
*.cert
*.pfx
*.p12

# Explicitly allow the safe sample template
!.env.example
!bot/.env.example

# ------------------------------------------------------------------------------
# 2. Python Runtime, Compilations & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# ------------------------------------------------------------------------------
# 3. Node.js & Frontend Artifacts (Vercel / Cloudflare Pages)
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Vercel Deployment Artifacts
.vercel

# ------------------------------------------------------------------------------
# 4. Cloudflare Worker Artifacts
# ------------------------------------------------------------------------------
.wrangler/

# ------------------------------------------------------------------------------
# 5. Media, Test Chunks & Temporary Files
# ------------------------------------------------------------------------------
*.mp4
*.mkv
*.webm
*.ts
*.m3u8
*.log
sample_chunk.*
full_video.*
scratch/

# ------------------------------------------------------------------------------
# 6. Operating System & Editor Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# IDEs & Editors
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
