# ==============================================================
# TeravidsPlay — Production Secure .gitignore
# Prevents accidental leakage of tokens, cookies, secrets & artifacts
# ==============================================================

# --- Environment & Sensitive Secret Files ---
.env
.env.*
*.env
!.env.example

# --- Python Build & Cache ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual Environments ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# --- Node & Frontend Build Artifacts ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Cloud Deployment Caches ---
.vercel/
.wrangler/
.turbo/
.cache/

# --- Operating System & Editor Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# --- Media & Test Artifacts ---
*.mp4
*.m3u8
*.ts
*.mkv
*.webm
*.log
sample_*
full_*
test_*
